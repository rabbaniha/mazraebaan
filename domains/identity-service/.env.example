# ============================================================
# identity-service environment configuration
# Copy to .env in this folder:  cp .env.example .env
# ============================================================

# Application port
PORT=4001

# Database (identity_db — Identity bounded context)
DB_HOST=localhost
DB_PORT=5432
DB_USER=mazraebaan
DB_PASS=mazraebaan_dev_pass
DB_NAME=identity_db

# ---- Asymmetric JWT (RS256) -----------------------------------------------
# The PRIVATE key lives ONLY here (identity-service). Other services verify
# tokens with the PUBLIC key served by this service's JWKS endpoint:
#   GET http://localhost:4001/auth/.well-known/jwks.json
#
# JWT_PRIVATE_KEY: PEM string of an RSA private key (recommended in prod).
#   Generate one with:
#     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#       -out private.pem
#   then either read it from a file or paste the PEM string here.
#   If omitted, an ephemeral key is generated at boot (dev only — tokens break
#   on restart).
JWT_PRIVATE_KEY=
JWT_KID=mazraebaan-signing-key-v1
JWT_ACCESS_TTL=900        # 15 minutes in seconds
JWT_REFRESH_TTL=2592000   # 30 days in seconds

# Account provisioning during onboarding is now EVENT-DRIVEN:
# the request is committed to the outbox and relayed to RabbitMQ.
RABBITMQ_URL=amqp://mazraebaan:mazraebaan_dev_pass@localhost:5672

# Still used for synchronous READS against accounts-service.
ACCOUNTS_SERVICE_URL=http://localhost:4002
INTERNAL_SERVICE_API_KEY=change-me-in-every-environment

NODE_ENV=development
