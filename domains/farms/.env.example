# ============================================================
# farms environment configuration
# Copy to .env in this folder:  cp .env.example .env
# ============================================================

# Application port (farms = 4003 per service port assignment)
PORT=4003

# Database (farms_db — Farm bounded context)
DB_HOST=localhost
DB_PORT=5432
DB_USER=mazraebaan
DB_PASS=mazraebaan_dev_pass
DB_NAME=farms_db

# ---- Access-token verification (RS256) ------------------------------------
# farms verifies access tokens independently using identity-service's PUBLIC
# key. Provide it either as a static PEM (JWT_PUBLIC_KEY) or point JWKS_URI at
# identity-service's JWKS endpoint (preferred — supports key rotation):
#   JWT_PUBLIC_KEY=
#   JWKS_URI=http://localhost:4001/auth/.well-known/jwks.json
JWT_PUBLIC_KEY=
JWKS_URI=http://localhost:4001/auth/.well-known/jwks.json

NODE_ENV=development
