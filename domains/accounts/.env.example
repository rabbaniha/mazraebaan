# ============================================================
# accounts environment configuration
# Copy to .env in this folder:  cp .env.example .env
# ============================================================

# Application port
PORT=4002

# Database (accounts_db — Account bounded context)
DB_HOST=localhost
DB_PORT=5432
DB_USER=mazraebaan
DB_PASS=mazraebaan_dev_pass
DB_NAME=accounts_db

# ---- Access-token verification (RS256) ------------------------------------
# accounts verifies access tokens independently using identity-service's PUBLIC
# key. Provide it either as a static PEM (JWT_PUBLIC_KEY) or point JWKS_URI at
# identity-service's JWKS endpoint (preferred — supports key rotation):
#   JWT_PUBLIC_KEY=
#   JWKS_URI=http://localhost:4001/auth/.well-known/jwks.json
JWT_PUBLIC_KEY=
JWKS_URI=http://localhost:4001/auth/.well-known/jwks.json

NODE_ENV=development

# Shared only with identity-service for onboarding provisioning.
INTERNAL_SERVICE_API_KEY=change-me-in-every-environment

# RabbitMQ consumer for cross-service events (owner-account provisioning).
RABBITMQ_URL=amqp://mazraebaan:mazraebaan_dev_pass@localhost:5672
