# ============================================================
# api-gateway environment configuration
# Copy to .env in this folder:  cp .env.example .env
# ============================================================

# Gateway HTTP port — the single external entry point to the microservices.
PORT=4000

# Internal service URLs (private network — services are NOT internet-facing).
IDENTITY_SERVICE_URL=http://localhost:4001
ACCOUNTS_SERVICE_URL=http://localhost:4002

# ---- Access-token verification (RS256, asymmetric) -------------------------
# The gateway verifies access tokens with identity-service's PUBLIC key. Provide
# it either as a static PEM (JWT_PUBLIC_KEY) or point JWKS_URI at identity's JWKS
# endpoint (preferred — supports key rotation). The private key lives ONLY in
# identity-service.
JWT_PUBLIC_KEY=
JWKS_URI=http://localhost:4001/auth/.well-known/jwks.json

NODE_ENV=development
